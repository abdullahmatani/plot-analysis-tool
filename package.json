{
  "name": "plot-analysis-tool",
  "private": true,
  "version": "0.1.4",
  "description": "Offline, private, in-browser spatial analysis on plot plans (DXF, DWG, PDF).",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test --project=chromium",
    "e2e:perf": "playwright test --project=perf",
    "perf:reference": "node scripts/perf-reference.mjs",
    "e2e:faults": "playwright test --project=faults",
    "bundle": "node scripts/make-bundle.mjs",
    "licences": "node scripts/gen-licences.mjs",
    "predev": "node scripts/gen-licences.mjs",
    "prebuild": "node scripts/gen-licences.mjs",
    "pretypecheck": "node scripts/gen-licences.mjs",
    "test:bundle": "node scripts/test-bundle.mjs",
    "release:check": "node scripts/release-check.mjs"
  },
  "dependencies": {
    "@countertype/clipper2-ts": "^1.5.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@mlightcad/libredwg-web": "0.8.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dexie": "^4.4.6",
    "earcut": "^3.2.4",
    "fflate": "^0.8.3",
    "flatbush": "^4.6.2",
    "immer": "^10.2.0",
    "lucide-react": "^0.577.0",
    "papaparse": "^5.7.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.8.1",
    "rbush": "^4.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.90.0",
    "react-resizable-panels": "^2.1.9",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.39.5",
    "@expo-google-fonts/noto-sans": "^0.4.2",
    "@expo-google-fonts/noto-sans-arabic": "^0.4.3",
    "@playwright/test": "1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "4.1.11",
    "workbox-window": "^7.4.1"
  }
}
