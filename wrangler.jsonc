// Cloudflare Workers deployment (hosted mode, FDR decision D-3 option a).
// Assets-only Worker: Cloudflare serves the static build, no server-side code
// runs, and no drawing or project data ever reaches the server (FDR C2).
//
// The Worker name in the Cloudflare dashboard must match `name` below, and
// the Workers Builds build command must be `npm run build` (it writes ./dist).
// The response headers, including the Content-Security-Policy, come from
// dist/_headers, which the build generates from the same policy as the page's
// <meta> tag (vite.config.ts).
{
  "name": "plot-analysis-tool",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
